---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import WorldMap from "@components/WorldMap";
import { SITE } from "@config";
---

<Layout title={`Map | ${SITE.title}`} description="A vector world map with layers.">
  <Header activeNav="map" />
  <button
    id="map-menu"
    class="map-menu focus-outline"
    type="button"
    aria-expanded="false"
    aria-controls="nav-menu"
  >
    Menu
  </button>
  <main id="main-content" class="map-shell">
    <WorldMap client:only="react" />
  </main>
</Layout>

<style>
  :global(body:has(.map-shell)) {
    height: 100dvh;
    overflow: hidden;
  }

  :global(body:has(.map-shell) > header) {
    position: fixed;
    z-index: 40;
    top: 0;
    right: 0;
    left: 0;
    background: rgb(var(--color-fill));
    transform: translateY(calc(-100% - 1px));
  }

  :global(body:has(.map-shell) > header.is-open) {
    transform: translateY(0);
  }

  .map-shell {
    @apply flex h-[100dvh] w-full max-w-none min-h-0 flex-1 flex-col overflow-hidden;
  }

  .map-shell :global(astro-island) {
    display: flex;
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    height: 100%;
  }

  .map-menu {
    position: fixed;
    z-index: 30;
    top: 0.75rem;
    right: 0.75rem;
    border: 1px solid rgb(var(--color-accent) / 0.3);
    background: rgb(var(--color-fill) / 0.92);
    padding: 0.25rem 0.6rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: rgb(var(--color-muted));
  }

  .map-menu:hover {
    color: rgb(var(--color-accent));
  }

  .map-menu.is-hidden {
    visibility: hidden;
    pointer-events: none;
  }
</style>

<script>
  const header = document.querySelector("header");
  const menuButton = document.querySelector("#map-menu");
  let pinned = false;

  const paint = () => {
    const open = pinned;
    header?.classList.toggle("is-open", open);
    if (header) header.toggleAttribute("inert", !open);
    menuButton?.setAttribute("aria-expanded", open ? "true" : "false");
    menuButton?.classList.toggle("is-hidden", open);
  };

  paint();

  menuButton?.addEventListener("click", event => {
    pinned = !pinned;
    paint();
    if (event.detail !== 0) return;
    if (pinned) header?.querySelector(".logo")?.focus();
    else menuButton.focus();
  });

  document.addEventListener("pointerdown", event => {
    if (!pinned) return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (header?.contains(target) || menuButton?.contains(target)) return;
    pinned = false;
    paint();
  });

  document.addEventListener("keydown", event => {
    if (event.key !== "Escape" || !pinned) return;
    pinned = false;
    paint();
    menuButton?.focus();
  });
</script>
