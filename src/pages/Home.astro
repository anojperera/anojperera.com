---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import { SOCIALS } from "@config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
const visiblePosts = sortedPosts.slice(0, 7);
const showFeaturedMark = visiblePosts.some(({ data }) => !data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;
const gitHubHref =
  SOCIALS.find(f => f.name.toLowerCase() === "github")?.href ?? "";

const formatDate = (datetime: Date) =>
  new Date(datetime).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<Layout>
  <Header />
  <main id="main-content">
    <section class="intro">
      <div class="intro-head">
        <h1>Blog</h1>
        <a href="/rss.xml" class="rss" aria-label="RSS feed">RSS</a>
      </div>
      <p>
        Here's a collection of how to's, opinon and general views. Its mostly
        focused around tech but you'll find the odd project on others.
      </p>
      <p>
        Read the blog posts or check
        <LinkButton
          className="underline underline-offset-4"
          href={gitHubHref}
        >
          README
        </LinkButton> for more info.
      </p>
      {socialCount > 0 && (
        <div class="socials">
          <Socials />
        </div>
      )}
    </section>

    <section class="index" aria-label="Posts">
      <ul>
        {
          visiblePosts.map(({ data }) => (
            <li>
              <a class="row" href={`/posts/${slugify(data)}`}>
                <div class="meta">
                  <time datetime={data.pubDatetime.toISOString()}>
                    {formatDate(data.pubDatetime)}
                  </time>
                  {showFeaturedMark && data.featured && (
                    <span class="mark">Featured</span>
                  )}
                </div>
                <div>
                  <h2>{data.title}</h2>
                  <p>{data.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <LinkButton href="/posts" className="all">
        All posts
      </LinkButton>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .intro {
    @apply pb-4 pt-12;
  }
  .intro-head {
    @apply mb-6 flex items-baseline justify-between gap-4;
  }
  .intro h1 {
    @apply text-4xl font-medium tracking-tight text-skin-accent sm:text-5xl;
  }
  .rss {
    @apply text-sm text-skin-accent underline-offset-4 hover:underline;
  }
  .intro p {
    @apply my-3 max-w-prose text-skin-muted;
  }
  .socials {
    @apply mt-6;
  }
  .socials :global(.social-icons) {
    @apply flex justify-start;
  }

  .index {
    @apply border-t border-skin-accent/25 py-8;
  }
  .row {
    @apply grid gap-1 border-b border-skin-accent/20 py-5 sm:grid-cols-[9rem_1fr] sm:items-baseline sm:gap-x-8;
  }
  .meta {
    @apply flex items-baseline gap-3 sm:flex-col sm:gap-1;
  }
  .meta time {
    @apply text-sm text-skin-muted;
  }
  .mark {
    @apply text-sm text-skin-accent;
  }
  .row h2 {
    @apply text-xl font-medium leading-snug tracking-tight text-skin-accent;
  }
  .row p {
    @apply mt-1 text-skin-muted;
  }
  .all {
    @apply mt-8 inline-block text-skin-accent underline-offset-4 hover:underline;
  }
</style>
