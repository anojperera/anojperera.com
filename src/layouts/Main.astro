---
import Breadcrumbs from "@components/Breadcrumbs.astro";

const { pageTitle, pageDesc } = Astro.props;
---

<Breadcrumbs />
<main id="main-content">
  <h1>{pageTitle}</h1>
  <p>{pageDesc}</p>
  <slot />
</main>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
  #main-content h1 {
    @apply text-3xl font-medium tracking-tight text-skin-accent sm:text-4xl;
  }
  #main-content p {
    @apply mb-8 mt-3 text-skin-muted;
  }
</style>
